EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# O login com Google não precisa de nenhuma variável aqui: as credenciais do
# provider (Client ID/Secret do Google Cloud) ficam configuradas no Supabase
# (dashboard do projeto hosted, ou nas variáveis SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID
# / SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET do seu ambiente ao rodar `supabase start` local).
